# Local development defaults. In Docker production, ACTOS_API_URL must use
# the API service's internal Compose hostname (for example, http://api:3100).
ACTOS_API_URL="http://127.0.0.1:3100"
ACTOS_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ACTOS_API_URL="http://127.0.0.1:3100"

# Origin serving user media (avatars, attachments). The backend's
# S3_PUBLIC_BASE_URL must be on this origin. Defaults to the production media
# host; set it to the local MinIO origin when running the production build
# against a local backend (for example http://127.0.0.1:3103).
ACTOS_MEDIA_URL="https://media.actos.com.tr"

# Public form of the same origin, inlined into the browser bundle at build
# time. Needed by the markdown policy that disallows remote images
# (lib/media.ts / ONEMLI.md). Defaults to the production media host.
NEXT_PUBLIC_ACTOS_MEDIA_URL="https://media.actos.com.tr"

# Communities UI (Phase 7). On by default; set to "false" at build time to
# hide the community routes and navigation. NEXT_PUBLIC_* is inlined at build
# time, so set it before `next build`.
NEXT_PUBLIC_FEATURE_COMMUNITIES="true"
