{
  "name": "actos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "test:all": "pnpm test && pnpm audit:bundle",
    "audit:bundle": "npx tsx scripts/verify-client-bundle.ts",
    "check:contrast": "npx tsx scripts/check-theme-contrast.ts",
    "seed:dev": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
